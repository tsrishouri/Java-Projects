    // =========================================================
    // BUS CLASS
    // =========================================================

    static class Bus {

        private String busId;
        private String source;
        private String destination;
        private String busType;
        private String departure;
        private String arrival;
        private double fare;

        private final int totalSeats = 50;

        // 2D array
        private boolean[][] seats =
                new boolean[5][10];

        public Bus(
                String busId,
                String source,
                String destination,
                String busType,
                String departure,
                String arrival,
                double fare,
                int occupiedSeats) {

            this.busId = busId;
            this.source = source;
            this.destination = destination;
            this.busType = busType;
            this.departure = departure;
            this.arrival = arrival;
            this.fare = fare;

            int count = 0;

            for (int i = 0;
                 i < seats.length;
                 i++) {

                for (int j = 0;
                     j < seats[i].length;
                     j++) {

                    if (count < occupiedSeats) {

                        seats[i][j] = true;

                        count++;
                    }
                }
            }
        }

        public String getBusId() {
            return busId;
        }

        public String getSource() {
            return source;
        }

        public String getDestination() {
            return destination;
        }

        public String getBusType() {
            return busType;
        }

        public String getDeparture() {
            return departure;
        }

        public String getArrival() {
            return arrival;
        }

        public double getFare() {
            return fare;
        }

        public int getTotalSeats() {
            return totalSeats;
        }

        public int getOccupiedSeats() {

            int count = 0;

            for (int i = 0;
                 i < seats.length;
                 i++) {

                for (int j = 0;
                     j < seats[i].length;
                     j++) {

                    if (seats[i][j]) {
                        count++;
                    }
                }
            }

            return count;
        }

        public int getAvailableSeats() {

            return totalSeats
                    - getOccupiedSeats();
        }

        public boolean isSeatBooked(
                int seatNumber) {

            if (seatNumber < 1 ||
                    seatNumber > 50) {

                return false;
            }

            int row =
                    (seatNumber - 1) / 10;

            int column =
                    (seatNumber - 1) % 10;

            return seats[row][column];
        }

        public boolean bookSeat(
                int seatNumber) {

            if (seatNumber < 1 ||
                    seatNumber > 50) {

                return false;
            }

            int row =
                    (seatNumber - 1) / 10;

            int column =
                    (seatNumber - 1) % 10;

            if (seats[row][column]) {

                return false;
            }

            seats[row][column] = true;

            return true;
        }

        public boolean cancelSeat(
                int seatNumber) {

            if (seatNumber < 1 ||
                    seatNumber > 50) {

                return false;
            }

            int row =
                    (seatNumber - 1) / 10;

            int column =
                    (seatNumber - 1) % 10;

            if (!seats[row][column]) {

                return false;
            }

            seats[row][column] = false;

            return true;
        }

        public void displaySeatLayout() {

            System.out.println();
            System.out.println(
                    "========== SEAT LAYOUT =========="
            );

            System.out.println(
                    "Bus ID: " + busId
            );

            System.out.println();

            for (int i = 0;
                 i < seats.length;
                 i++) {

                for (int j = 0;
                     j < seats[i].length;
                     j++) {

                    int seatNumber =
                            i * 10 + j + 1;

                    if (seats[i][j]) {

                        System.out.printf(
                                "[X%02d] ",
                                seatNumber
                        );

                    } else {

                        System.out.printf(
                                "[O%02d] ",
                                seatNumber
                        );
                    }
                }

                System.out.println();
            }

            System.out.println();
            System.out.println(
                    "O = Available"
            );

            System.out.println(
                    "X = Occupied"
            );
        }

        public void displayDetails() {

            System.out.println();
            System.out.println(
                    "------------------------------"
            );

            System.out.println(
                    "Bus ID      : " + busId
            );

            System.out.println(
                    "Route       : "
                            + source
                            + " -> "
                            + destination
            );

            System.out.println(
                    "Bus Type    : " + busType
            );

            System.out.println(
                    "Departure   : " + departure
            );

            System.out.println(
                    "Arrival     : " + arrival
            );

            System.out.println(
                    "Fare        : ₹" + fare
            );

            System.out.println(
                    "Total Seats : " + totalSeats
            );

            System.out.println(
                    "Occupied    : "
                            + getOccupiedSeats()
            );

            System.out.println(
                    "Available   : "
                            + getAvailableSeats()
            );

            System.out.println(
                    "------------------------------"
            );
        }
    }

