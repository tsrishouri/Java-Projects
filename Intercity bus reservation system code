    // =========================================================
    // SMART BUS RECOMMENDATION
    // =========================================================

    static void smartBusRecommendation() {

        System.out.println();
        System.out.println("====== SMART BUS RECOMMENDATION ======");

        String source =
                readString("Enter source: ");

        String destination =
                readString("Enter destination: ");

        double budget =
                readDouble("Enter maximum budget: ");

        Bus bestBus = null;

        double bestScore = -1;

        for (Bus bus : buses) {

            if (!bus.getSource()
                    .equalsIgnoreCase(source)) {

                continue;
            }

            if (!bus.getDestination()
                    .equalsIgnoreCase(destination)) {

                continue;
            }

            if (bus.getFare() > budget) {

                continue;
            }

            if (bus.getAvailableSeats() <= 0) {

                continue;
            }

            double score = 0;

            // More available seats = higher score
            score += bus.getAvailableSeats();

            // AC bus gets additional comfort score
            if (bus.getBusType()
                    .toLowerCase()
                    .contains("ac")) {

                score += 20;
            }

            // Lower fare gets better score
            score +=
                    (2000 - bus.getFare()) / 100;

            if (score > bestScore) {

                bestScore = score;
                bestBus = bus;
            }
        }

        if (bestBus == null) {

            System.out.println(
                    "No suitable bus found."
            );

        } else {

            System.out.println();
            System.out.println(
                    "Recommended Bus:"
            );

            bestBus.displayDetails();
        }
    }

    // =========================================================
    // BOOK TICKET
    // =========================================================

    static void bookTicket() {

        System.out.println();
        System.out.println("========== BOOK TICKET ==========");

        String busId =
                readString("Enter Bus ID: ");

        Bus bus = findBus(busId);

        if (bus == null) {

            System.out.println("Bus not found.");
            return;
        }

        if (bus.getAvailableSeats() <= 0) {

            System.out.println(
                    "No seats available."
            );

            return;
        }

        bus.displaySeatLayout();

        int seatNumber =
                readInt("Enter seat number: ");

        if (seatNumber < 1 ||
                seatNumber > 50) {

            System.out.println(
                    "Invalid seat number."
            );

            return;
        }

        if (bus.isSeatBooked(seatNumber)) {

            System.out.println(
                    "Seat already booked."
            );

            return;
        }

        System.out.println();
        System.out.println("Enter Passenger Details");

        String name =
                readString("Name: ");

        String phone =
                readString("Phone: ");

        int age =
                readInt("Age: ");

        String gender =
                readString("Gender: ");

        Passenger passenger =
                new Passenger(
                        name,
                        phone,
                        age,
                        gender
                );

        passengers.add(passenger);

        double amount =
                bus.getFare();

        // Senior citizen discount
        if (age >= 60) {

            amount =
                    amount * 0.90;

            System.out.println(
                    "10% senior citizen discount applied."
            );
        }

        boolean booked =
                bus.bookSeat(seatNumber);

        if (!booked) {

            System.out.println(
                    "Seat booking failed."
            );

            return;
        }

        String ticketId =
                "T" + ticketCounter++;

        Ticket ticket =
                new Ticket(
                        ticketId,
                        passenger,
                        busId,
                        seatNumber,
                        amount
                );

        tickets.add(ticket);

        saveToFile(
                "bookings.txt",
                ticket.toString()
        );

        System.out.println();
        System.out.println(
                "Ticket booked successfully!"
        );

        ticket.displayTicket();
    }

