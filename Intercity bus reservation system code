    // =========================================================
    // CANCEL TICKET
    // =========================================================

    static void cancelTicket() {

        String ticketId =
                readString("Enter Ticket ID: ");

        for (Ticket ticket : tickets) {

            if (ticket.getTicketId()
                    .equalsIgnoreCase(ticketId)) {

                if (ticket.getStatus()
                        .equals("CANCELLED")) {

                    System.out.println(
                            "Ticket already cancelled."
                    );

                    return;
                }

                Bus bus =
                        findBus(ticket.getBusId());

                if (bus != null) {

                    bus.cancelSeat(
                            ticket.getSeatNumber()
                    );
                }

                ticket.cancel();

                System.out.println(
                        "Ticket cancelled successfully."
                );

                return;
            }
        }

        System.out.println(
                "Ticket not found."
        );
    }

