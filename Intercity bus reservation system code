    // =========================================================
    // FILE WRITING
    // =========================================================

    static void saveToFile(
            String fileName,
            String data) {

        try {

            File folder =
                    new File("data");

            if (!folder.exists()) {
                folder.mkdir();
            }

            FileWriter writer =
                    new FileWriter(
                            "data/" + fileName,
                            true
                    );

            BufferedWriter buffer =
                    new BufferedWriter(writer);

            buffer.write(data);
            buffer.newLine();

            buffer.close();
            writer.close();

        } catch (IOException e) {

            System.out.println(
                    "File writing error: "
                            + e.getMessage()
            );
        }
    }

    // =========================================================
    // FILE READING
    // =========================================================

    static void displayFile(
            String fileName) {

        File file =
                new File(
                        "data/" + fileName
                );

        if (!file.exists()) {

            System.out.println(
                    "No saved records found."
            );

            return;
        }

        try {

            FileReader reader =
                    new FileReader(file);

            BufferedReader buffer =
                    new BufferedReader(reader);

            String line;

            System.out.println();
            System.out.println(
                    "---------- SAVED DATA ----------"
            );

            while ((line =
                    buffer.readLine()) != null) {

                System.out.println(line);
            }

            buffer.close();
            reader.close();

        } catch (IOException e) {

            System.out.println(
                    "File reading error: "
                            + e.getMessage()
            );
        }
    }

    // =========================================================
    // SORTING
    // =========================================================

    static void sortingDemo() {

        // Copy array so original bus order is unchanged
        Bus[] sortedBuses =
                Arrays.copyOf(
                        buses,
                        buses.length
                );

        // Bubble sort
        for (int i = 0;
             i < sortedBuses.length - 1;
             i++) {

            for (int j = 0;
                 j < sortedBuses.length - i - 1;
                 j++) {

                if (sortedBuses[j].getFare()
                        > sortedBuses[j + 1].getFare()) {

                    Bus temp =
                            sortedBuses[j];

                    sortedBuses[j] =
                            sortedBuses[j + 1];

                    sortedBuses[j + 1] =
                            temp;
                }
            }
        }

        System.out.println();
        System.out.println(
                "========== BUSES SORTED BY FARE =========="
        );

        for (Bus bus : sortedBuses) {

            System.out.println(
                    bus.getBusId()
                            + " | "
                            + bus.getSource()
                            + " -> "
                            + bus.getDestination()
                            + " | ₹"
                            + bus.getFare()
            );
        }
    }

